# Copy to .env locally. The integrated microphone writes directly to the local store.
# Never add a real token to Git. Placeholder tokens keep ingestion disabled.
INGEST_TOKEN=replace-with-a-long-random-token
DEVICE_ID=begin17-floor7
# Exact public website origin if the API is hosted separately.
ALLOWED_ORIGIN=https://udid.github.io
# Defaults: HOST=127.0.0.1, PORT=8000. Use --live for live mode.
# For Cloudflare Tunnel, also pass --public-port 8001 and route only to that port.
# Port 8000 remains local for authenticated observation/heartbeat writes.
# Optional microphone settings (also available as command-line options):
# DETECTOR_CONFIG=data/server-config.json
# AUDIO_DEVICE=USB PnP Sound Device
